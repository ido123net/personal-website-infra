# Place actual values outside the repo. Installed on the VPS with mode 0600.
RESTIC_REPOSITORY=s3:https://s3.example.com/personal-backups/control-plane
AWS_ACCESS_KEY_ID=replace-with-a-scoped-storage-key
AWS_SECRET_ACCESS_KEY=replace-with-the-storage-secret
RESTIC_PASSWORD_FILE=/etc/personal-infra/restic-password
# Optional for S3-compatible services:
# AWS_DEFAULT_REGION=auto
