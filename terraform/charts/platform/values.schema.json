{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["acmeEmail", "ingressClass"],
  "properties": {
    "acmeEmail": {"type": "string", "pattern": "^[^ @]+@[^ @]+\\.[^ @]+$"},
    "ingressClass": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
